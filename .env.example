# ============================================================
# ミナモ サポート研修AI 設定例
# 値はすべてダミーです。実在のキーやエンドポイントは記載しません。
# 使うときは cp .env.example .env してから編集してください。
# ============================================================

# --- モード ---
# local : 外部APIを呼ばない。既定値。検索・対話・評価がすべて動きます。
# cloud : OpenAI互換APIで回答生成・AI採点・音声入力を有効にします。
APP_MODE=local

# --- クラウドモードで使う設定 ---
# APP_MODE=cloud のときだけ必要です。未設定ならローカルモードにフォールバックします。
OPENAI_API_KEY=
# OpenAI互換エンドポイントを使う場合のみ指定（未指定なら公式）
# OPENAI_BASE_URL=https://api.example.com/v1

# --- モデル ---
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
# TRANSCRIPTION_MODEL=whisper-1

# --- 生成の挙動 ---
# TEMPERATURE=0.3
# TIMEOUT_SECONDS=30
# MAX_RETRIES=2

# --- RAGのパラメータ（実験で変えるのはここ） ---
# CHUNK_SIZE=600
# CHUNK_OVERLAP=100
# TOP_K=4
# SCORE_THRESHOLD は「最上位に対する相対スコア」の下限です。
# 最上位は常に 1.0 に正規化されるため、2位以下の足切りに効きます。
# SCORE_THRESHOLD=0.15

# --- アップロード制限 ---
# MAX_UPLOAD_MB=5
